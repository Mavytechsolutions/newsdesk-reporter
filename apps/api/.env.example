# ---- MAVY NEWS API settings ----
# Copy this file to ".env" and fill in the values.

NODE_ENV=development
PORT=4000

# Database (the docker-compose file in /infra creates this for you)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mavy?schema=public

# Security keys — use long random text in production (at least 32 characters each)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# OTP / SMS
# SMS_PROVIDER=console prints the OTP in the server window (development only).
# For real SMS set SMS_PROVIDER=msg91 and fill the MSG91 values (needs DLT-approved template).
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
OTP_TTL_SECONDS=300
OTP_MAX_PER_HOUR=5
OTP_MAX_ATTEMPTS=5

# First Super Admin account, created by the seed command
SEED_ADMIN_EMAIL=admin@mavynews.in
SEED_ADMIN_PASSWORD=ChangeThisPassword!2026

# Comma-separated list of websites allowed to call the API (the admin dashboard)
CORS_ORIGINS=http://localhost:3000
